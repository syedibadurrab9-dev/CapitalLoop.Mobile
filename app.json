{
  "expo": {
    "name": "CapitalLoop",
    "slug": "capitalloopmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "icon": "./src/assets/images/icon.png",
    "scheme": "capitalloop",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capitalloop.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "CapitalLoop requires access to your camera to seamlessly scan your Binance API Management desktop QR codes."
      }
    },
    "android": {
      "package": "com.capitalloop.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CapitalLoop to access your device camera to scan account desktop links smoothly."
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://capitalloop.com",
          "root": "src/app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4cee159-4309-41b4-8c9f-d4d664a9520a"
      }
    },
    "owner": "syedibadshah"
  }
}