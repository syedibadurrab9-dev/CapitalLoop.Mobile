{
  "expo": {
    "name": "CapitalLoop",
    "slug": "capitalloopmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "scheme": "capitalloop",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibad.capitalloop",
      "infoPlist": {
        "NSCameraUsageDescription": "CapitalLoop requires access to your camera to seamlessly scan your Binance API Management desktop QR codes."
      }
    },
    "android": {
      "package": "com.ibad.capitalloop",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CapitalLoop to access your device camera to scan account desktop links smoothly."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4cee159-4309-41b4-8c9f-d4d664a9520a"
      }
    },
    "owner": "syedibadshah"
  }
}