{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "app/*": [
        "./app/*"
      ]
    },
    "types": [
      "expo"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}
